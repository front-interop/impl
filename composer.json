{
    "name": "front-interop/impl",
    "type": "library",
    "description": "Reference implementations for Front-Interop.",
    "keywords": ["front", "controller"],
    "license": "MIT",
    "homepage": "https://github.com/front-interop/impl",
    "authors": [
        {
            "name": "Paul M. Jones",
            "email": "pmjones@pmjones.io",
            "homepage": "https://pmjones.io",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.4",
        "front-interop/interface": "1.x@dev"
    },
    "autoload": {
        "psr-4" : {
            "FrontInterop\\Impl\\": "src/"
        }
    },
    "require-dev": {
        "pds/composer-script-names": "^1.0",
        "pds/skeleton": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "pmjones/php-styler": "0.x@dev"
    },
    "autoload-dev": {
        "psr-4" : {
            "FrontInterop\\Impl\\": "tests/"
        }
    },
    "scripts": {
        "analyze": "./vendor/bin/phpstan",
        "check": "composer test && composer analyze && composer cs-clear && composer cs-check",
        "cs-check": "./vendor/bin/php-styler check",
        "cs-clear": "./vendor/bin/php-styler clear-cache",
        "cs-fix": "./vendor/bin/php-styler apply",
        "hello": "php -S localhost:8080 -t public",
        "test": "./vendor/bin/phpunit",
        "test-coverage": "./vendor/bin/phpunit --coverage-html=./tmp/coverage"
    }
}
